        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sargish</item>
        <item name="colorPrimaryVariant">@color/sargish</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/sargish</item>

